{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试当前活动文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "pythonArgs": ["-u"],
            "justMyCode": false,
            "env": {
                "PYTHONPATH":"${workspaceFolder}"
            },
            "cwd":"${workspaceFolder}",
            "preLaunchTask": "pyqt_convert",

        },
        {
            "name": "Python 调试当前项目",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "pythonArgs": ["-u"],
            "justMyCode": false,
            "env": {
                "PYTHONPATH":"${workspaceFolder}"
            },
            "cwd":"${workspaceFolder}",
            "preLaunchTask": "pyqt_convert",
        },
        {
            "name": "Python 调试并打包整个项目",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": ["--mode", "production"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONUNBUFFERED": "1"
            },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build_package",
        }
    ]
}