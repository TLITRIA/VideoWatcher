{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_package",
            "type": "shell",
            "command": "${workspaceFolder}/.VideoWatcher/Scripts/pyinstaller.exe",
            "args": [
                "--onedir",
                "--name=${fileWorkspaceFolderBasename}",
                "--distpath=${workspaceFolder}/.dist",
                "--workpath=${workspaceFolder}/.build",
                "--specpath=${workspaceFolder}/.spec",
                "-p", "E:/VideoWatcher",
                "--optimize", "2",
                "--clean",
                "-y",
                "main.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": "pyqt_convert"
        },
        {
            "label": "pyqt_convert",
            "type": "shell",
            "command": "${workspaceFolder}/.VideoWatcher/Scripts/python.exe",
            "args":[
                "${workspaceFolder}/Tools/autoConvertUI.py"
            ],
            "options" :{
                "env": {"PYTHONPATH": "${workspaceFolder}"}
            }
        },
    ]
}